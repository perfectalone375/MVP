# Copy to .env.local and fill in your own values. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, keep secret

# OpenAI or any OpenAI-compatible provider (e.g. OpenRouter)
OPENAI_API_KEY=your-openai-or-openrouter-key
OPENAI_BASE_URL=https://api.openai.com/v1

# AssemblyAI (interview transcription)
ASSEMBLYAI_API_KEY=your-assemblyai-key

# Agora (video meetings)
NEXT_PUBLIC_AGORA_APP_ID=your-agora-app-id

# FACEIO (face verification)
FACEIO_PUBLIC_ID=your-faceio-public-id

# Public URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000
